// use prisma-8

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id        Int      @id @default(autoincrement())
  company   String
  role      String
  location  String
  status    String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  userId Int
  user   User @relation(fields: [userId], references: [id])
}